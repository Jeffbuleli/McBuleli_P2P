NODE_ENV=development
PORT=4000
# Mettre l’URL entre guillemets si elle contient ?sslmode= ou ?schema= (zsh interprète ? sinon).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/McBuleli_P2P?schema=public"
# Optional — only if Redis is running (e.g. brew services start redis)
# REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48 (then trim/pad to requirements)
JWT_ACCESS_SECRET=change-me-minimum-32-characters-secret-key!!
JWT_REFRESH_SECRET=change-me-other-32-characters-secret-key!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Prod (exemple) : APP_URL=https://mcbulelip2p.vercel.app  —  API_URL=https://mcbuleli-api.onrender.com

# AES-256: use a 32+ byte string (scrypt derives key inside app)
ENCRYPTION_KEY=change-me-32-char-encryption-key!

# Front Next.js — séparer par des virgules. En prod Render, inclure le domaine Vercel exact (schéma + host).
# Ex. prod : https://mcbulelip2p.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# E-mails admin (rétrocompat) : accès /api/admin même sans rôle ADMIN en base. Préférez l’UI Admin → Rôles.
ADMIN_EMAILS=admin@mcbuleli.dev

# Secours trésorerie : si aucun utilisateur n’a le rôle TREASURY en base, les frais staking vont vers cet UUID
# PLATFORM_STAKING_FEES_USER_ID=

# PawaPay — utiliser la SANDBOX (démo) par défaut ; ne passer à https://api.pawapay.io qu’en prod réelle.
PAWAPAY_API_KEY=
PAWAPAY_WEBHOOK_SECRET=
# Optionnel : si absent, le serveur utilise https://api.sandbox.pawapay.io (voir env.ts)
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# URL publique que tu enregistres dans le dashboard PawaPay (démo / prod) — chemin fixe : /api/webhooks/pawapay
# Ex. API Render : https://mcbuleli-api.onrender.com/api/webhooks/pawapay
# Ex. local + ngrok : https://<ton-sous-domaine>.ngrok-free.app/api/webhooks/pawapay
# (PawaPay n’appelle jamais localhost directement.)
CALLBACK_URL=https://mcbuleli-api.onrender.com/api/webhooks/pawapay
# Correspondants Mobile Money (exemples — valeurs réelles du dashboard PawaPay / corridor DRC)
PAWAPAY_CORRESPONDENT_CDF=
PAWAPAY_CORRESPONDENT_USD=
PAWAPAY_CORRESPONDENT_EUR=
PAWAPAY_PAYOUT_CORRESPONDENT_CDF=
PAWAPAY_PAYOUT_CORRESPONDENT_USD=
PAWAPAY_PAYOUT_CORRESPONDENT_EUR=
PAWAPAY_PAYOUT_COUNTRY=COD

# Optional: Binance public API does not require keys for price endpoint
BINANCE_API_KEY=
BINANCE_API_SECRET=

# —— On-chain USDT (custodial deposit / withdraw) ——
# Per-network cold/hot addresses shown to users; must match what you verify on Tron/EVM.
# Fixed fee (USDT) per deposit and per withdrawal; net-to-user is gross deposit minus fee.
# CRYPTO_SERVICE_FEE_USDT=2
# Treasury UUID receiving fee revenue (defaults to PLATFORM_STAKING_FEES_USER_ID if unset).
# PLATFORM_CRYPTO_FEES_USER_ID=
# CRYPTO_DEPOSIT_USDT_TRC20_ADDRESS=
# CRYPTO_DEPOSIT_USDT_ERC20_ADDRESS=
# CRYPTO_DEPOSIT_USDT_BEP20_ADDRESS=
# TRON_PRO_API_KEY=
# TRON_FULLNODE_URL=https://api.trongrid.io
# ETH_MAINNET_RPC_URL=
# BSC_MAINNET_RPC_URL=
# ETHERSCAN_API_KEY=
# BSCSCAN_API_KEY=
# Local testing: auto-complete mock withdrawal (never in real prod)
# CRYPTO_WITHDRAW_CEX_MOCK=1

BCRYPT_ROUNDS=12
