NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcbuleli
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48 (then trim/pad to requirements)
JWT_ACCESS_SECRET=change-me-minimum-32-characters-secret-key!!
JWT_REFRESH_SECRET=change-me-other-32-characters-secret-key!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# AES-256: use a 32+ byte string (scrypt derives key inside app)
ENCRYPTION_KEY=change-me-32-char-encryption-key!

CORS_ORIGIN=http://localhost:3000

# Comma-separated admin emails (full access to /api/admin routes)
ADMIN_EMAILS=admin@mcbuleli.dev

# PawaPay (production)
PAWAPAY_API_KEY=
PAWAPAY_WEBHOOK_SECRET=
PAWAPAY_BASE_URL=https://api.pawapay.io

# Optional: Binance public API does not require keys for price endpoint
BINANCE_API_KEY=
BINANCE_API_SECRET=

BCRYPT_ROUNDS=12
