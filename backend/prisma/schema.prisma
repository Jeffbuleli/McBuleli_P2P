generator client {
  provider = "prisma-client-js"
}

/// Seed: `npm run db:seed`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CryptoAsset {
  USDT
  BTC
}

enum FiatCurrency {
  USD
  CDF
  EUR
}

enum TransactionType {
  DEPOSIT_FIAT
  WITHDRAW_FIAT
  INTERNAL_TRANSFER_OUT
  INTERNAL_TRANSFER_IN
  P2P_ESCROW_LOCK
  P2P_ESCROW_RELEASE
  P2P_REFUND
  ADJUSTMENT
  STAKE_LOCK
  STAKE_EXIT
  DEPOSIT_CRYPTO
  WITHDRAW_CRYPTO
}

enum ChainNetwork {
  TRC20
  ERC20
  BEP20
}

enum CryptoDepositIntentStatus {
  AWAITING_TX
  PENDING_VALIDATION
  CONFIRMED
  FAILED
}

enum CryptoOnchainWithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum StakeStatus {
  ACTIVE
  COMPLETED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum P2POfferSide {
  BUY
  SELL
}

enum P2POfferStatus {
  ACTIVE
  PAUSED
  FILLED
  CANCELLED
}

enum P2PTradeStatus {
  PENDING
  PAID
  RELEASED
  CANCELLED
  DISPUTED
}

enum P2PDisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SELLER
  CANCELLED
}

enum P2PActivityAction {
  TRADE_CREATED
  MARKED_PAID
  RELEASED
  CANCELLED
  DISPUTE_OPENED
  AUTO_EXPIRED
  DISPUTE_RESOLVED_BUYER
  DISPUTE_RESOLVED_SELLER
}

enum UserNotificationType {
  P2P_TRADE_NEW
  P2P_TRADE_PAID
  P2P_TRADE_RELEASED
  P2P_TRADE_CANCELLED
  P2P_DISPUTE_OPENED
}

enum PapawTxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WalletKind {
  CRYPTO
  FIAT
}

/// Rôles plateforme assignables par un admin (remplace en partie ADMIN_EMAILS / UUID trésorerie en dur).
enum StaffRole {
  ADMIN
  /// Compte qui reçoit les frais d’intérêts staking (un seul à la fois en base).
  TREASURY
  /// Agent (support / modération) — droits métier à brancher progressivement.
  AGENT
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?
  username        String    @unique
  passwordHash    String
  fullName        String
  country         String    @default("CD")
  kycStatus       KycStatus @default(PENDING)
  profilePhotoUrl String?
  p2pRatingAvg    Decimal   @default(0) @db.Decimal(4, 2)
  /// Successful P2P trades (crypto released to buyer).
  completedTrades Int       @default(0)
  /// All P2P trades that reached a terminal outcome (released, cancelled, or dispute-resolved).
  p2pTradesTotal  Int       @default(0)
  isFrozen        Boolean   @default(false)
  isBlacklisted   Boolean   @default(false)
  twoFactorEnabled Boolean  @default(false)
  /// Encrypted TOTP secret (AES-256-GCM); never store plain
  twoFactorSecretEnc String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  walletAccounts     WalletAccount[]
  sessions           Session[]
  devices            Device[]
  refreshTokens      RefreshToken[]
  transactions       Transaction[]
  ledgerEntries      LedgerEntry[]
  offers             P2POffer[]
  tradesAsBuyer      P2PTrade[]        @relation("BuyerTrades")
  tradesAsSeller     P2PTrade[]        @relation("SellerTrades")
  tradeMessages      P2PTradeMessage[]
  ratingsGiven       Rating[]          @relation("RatingsFrom")
  ratingsReceived    Rating[]          @relation("RatingsTo")
  disputesOpened     P2PDispute[]      @relation("DisputeOpener")
  suspiciousFlags    SuspiciousFlag[]
  fiatDeposits       FiatDeposit[]
  fiatWithdrawals    FiatWithdrawal[]
  internalTransfersOut InternalTransfer[] @relation("TransferFrom")
  internalTransfersIn  InternalTransfer[] @relation("TransferTo")
  kycSubmissions     KycSubmission[]
  stakes             UserStake[]
  staffRoles         UserStaffRole[] @relation("UserStaffRoles")
  staffRolesAssigned UserStaffRole[] @relation("StaffAssignments")
  notifications    Notification[]
  cryptoDepositIntents   CryptoDepositIntent[]
  cryptoOnchainWithdrawals CryptoOnchainWithdrawal[]

  @@index([email])
  @@index([username])
  @@index([country])
}

model KycSubmission {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentUrl String?
  notes     String?
  reviewedAt DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  deviceLabel  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Device {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  lastIp      String?
  lastSeenAt  DateTime @default(now())
  label       String?

  @@unique([userId, fingerprint])
}

model WalletAccount {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           WalletKind
  /// Currency code: USDT, BTC, CDF, USD, EUR
  currencyCode   String
  /// Available balance (custodial ledger)
  balance        Decimal     @default(0) @db.Decimal(28, 8)
  /// Locked for P2P escrow / pending ops
  lockedBalance  Decimal     @default(0) @db.Decimal(28, 8)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([userId, kind, currencyCode])
  @@index([userId])
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @db.Uuid
  account       WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(28, 8)
  balanceAfter  Decimal  @db.Decimal(28, 8)
  type          String
  referenceType String
  referenceId   String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  referenceId String            @unique
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(28, 8)
  currency    String
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([type, status])
}

model InternalTransfer {
  id          String   @id @default(uuid()) @db.Uuid
  referenceId String   @unique
  fromUserId  String   @db.Uuid
  toUserId    String   @db.Uuid
  fromUser    User     @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(28, 8)
  currency    String
  note        String?
  createdAt   DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model FiatDeposit {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(28, 8)
  currency      FiatCurrency
  /// MSISDN normalisé (ex. 243… ) pour Mobile Money
  phoneNumber   String?
  /// Code correspondant PawaPay (ex. ORANGE_MOMO_COD)
  correspondent String?
  /// Réf. côté PSP après callback (ex. providerTransactionId)
  externalRef   String?
  pawapayPayload Json?
  failureReason String?
  lastWebhookAt DateTime?
  status        PapawTxStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([externalRef])
  @@index([userId])
  @@index([status])
}

model FiatWithdrawal {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(28, 8)
  currency      FiatCurrency
  destinationMsisdn String?
  /// Code correspondant PawaPay pour payout
  correspondent String?
  externalRef   String?
  pawapayPayload Json?
  failureReason String?
  lastWebhookAt DateTime?
  status        PapawTxStatus @default(PENDING)
  reviewedBy    String?
  fraudScore    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model P2POffer {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  side            P2POfferSide
  cryptoAsset     CryptoAsset    @default(USDT)
  fiatCurrency    FiatCurrency
  pricePerUnit    Decimal        @db.Decimal(28, 8)
  minFiat         Decimal        @db.Decimal(28, 8)
  maxFiat         Decimal        @db.Decimal(28, 8)
  paymentMethods  Json
  status          P2POfferStatus @default(ACTIVE)
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  trades P2PTrade[]

  @@index([userId, status])
  @@index([cryptoAsset, fiatCurrency, status])
}

model P2PTrade {
  id             String         @id @default(uuid()) @db.Uuid
  referenceId    String         @unique
  offerId        String         @db.Uuid
  offer          P2POffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyerId        String         @db.Uuid
  sellerId       String         @db.Uuid
  buyer          User           @relation("BuyerTrades", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User           @relation("SellerTrades", fields: [sellerId], references: [id], onDelete: Cascade)
  cryptoAmount   Decimal        @db.Decimal(28, 8)
  fiatAmount     Decimal        @db.Decimal(28, 8)
  status         P2PTradeStatus @default(PENDING)
  timerEndsAt    DateTime
  paidAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages  P2PTradeMessage[]
  dispute   P2PDispute?
  rating    Rating?
  activities P2PTradeActivity[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([offerId, status])
}

model P2PTradeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  tradeId   String   @db.Uuid
  trade     P2PTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId  String   @db.Uuid
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([tradeId, createdAt])
}

model P2PDispute {
  id         String            @id @default(uuid()) @db.Uuid
  tradeId    String            @unique @db.Uuid
  trade      P2PTrade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  openedById String            @db.Uuid
  openedBy   User              @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  reason     String
  status     P2PDisputeStatus  @default(OPEN)
  resolution String?
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  tradeId    String   @unique @db.Uuid
  trade      P2PTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromUserId String   @db.Uuid
  toUserId   String   @db.Uuid
  fromUser   User     @relation("RatingsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("RatingsTo", fields: [toUserId], references: [id], onDelete: Cascade)
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

/// Append-only audit trail for P2P trades (compliance & support).
model P2PTradeActivity {
  id        String            @id @default(uuid()) @db.Uuid
  tradeId   String            @db.Uuid
  trade     P2PTrade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorId   String?           @db.Uuid
  action    P2PActivityAction
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([tradeId, createdAt])
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserNotificationType
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// User-initiated on-chain deposit: address shown only after risk acknowledgement.
model CryptoDepositIntent {
  id                      String                   @id @default(uuid()) @db.Uuid
  userId                  String                   @db.Uuid
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset                   CryptoAsset
  network                 ChainNetwork
  /// Custodial deposit address (must match chain explorer validation).
  platformAddress         String
  memoTag                 String?
  minAmount               Decimal                  @db.Decimal(28, 8)
  /// Service fee (USDT) snapshot at creation; on-chain gross must cover minAmount + this fee.
  serviceFeeUsdt          Decimal                  @default(2) @db.Decimal(28, 8)
  confirmationsRequired   Int                      @default(12)
  status                  CryptoDepositIntentStatus @default(AWAITING_TX)
  riskWarningAcceptedAt   DateTime
  userMarkedSentAt        DateTime?
  txid                    String?
  amountCredited          Decimal?                 @db.Decimal(28, 8)
  failureReason           String?
  explorerValidationJson  Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  onchainTxidRecord       UsedOnchainTxid?

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Global uniqueness for TXIDs per network (prevents double-spend across users).
model UsedOnchainTxid {
  id                String                 @id @default(uuid()) @db.Uuid
  network           ChainNetwork
  txid              String
  depositIntentId   String?                @unique @db.Uuid
  depositIntent     CryptoDepositIntent?   @relation(fields: [depositIntentId], references: [id], onDelete: SetNull)
  withdrawalId      String?                @unique @db.Uuid
  withdrawal        CryptoOnchainWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())

  @@unique([network, txid])
  @@index([txid])
}

model CryptoOnchainWithdrawal {
  id            String                       @id @default(uuid()) @db.Uuid
  referenceId   String                       @unique
  userId        String                       @db.Uuid
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         CryptoAsset
  network       ChainNetwork
  toAddress     String
  /// Net amount sent on-chain to the user’s external address.
  amount        Decimal                      @db.Decimal(28, 8)
  /// Platform fee (USDT); total locked from user = amount + feeAmount.
  feeAmount     Decimal                      @db.Decimal(28, 8)
  status        CryptoOnchainWithdrawalStatus  @default(PENDING)
  cexOrderId    String?
  txid          String?
  failureReason String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  onchainTxidRecord UsedOnchainTxid?

  @@index([userId, status])
  @@index([status, createdAt])
}

model SuspiciousFlag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  severity  Int      @default(1)
  metadata  Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model StakingPool {
  id              String      @id @default(uuid()) @db.Uuid
  slug            String      @unique
  asset           CryptoAsset @default(USDT)
  nameFr          String?
  nameEn          String?
  /// Annual yield in percent (e.g. 8.5 = 8.5% / year), simple interest basis
  apyAnnual       Decimal     @db.Decimal(12, 6)
  lockDays        Int
  minAmount       Decimal     @db.Decimal(28, 8)
  maxStakePerUser Decimal?    @db.Decimal(28, 8)
  /// Share of gross interest retained by the platform (0–100)
  rewardFeePercent Decimal    @default(0) @db.Decimal(8, 4)
  /// Minimum seconds between two stake creations by the same user on this pool
  cooldownSeconds Int         @default(0)
  isActive        Boolean     @default(true)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())

  stakes UserStake[]
}

model UserStake {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolId           String      @db.Uuid
  pool             StakingPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  amount           Decimal     @db.Decimal(28, 8)
  apySnapshot      Decimal     @db.Decimal(12, 6)
  lockDaysSnapshot Int
  /// Fee on gross interest, copied from pool at lock time
  rewardFeePercentSnapshot Decimal @default(0) @db.Decimal(8, 4)
  startedAt        DateTime    @default(now())
  maturesAt        DateTime
  rewardAmount     Decimal?    @db.Decimal(28, 8)
  status           StakeStatus @default(ACTIVE)
  settledAt        DateTime?

  @@index([userId, status])
  @@index([status, maturesAt])
}

model UserStaffRole {
  userId           String    @db.Uuid
  role             StaffRole
  assignedAt       DateTime  @default(now())
  assignedByUserId String?   @db.Uuid

  user       User  @relation("UserStaffRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("StaffAssignments", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model SystemConfig {
  id    String @id @default("singleton")
  dailyWithdrawLimitFiat Decimal @default(500000) @db.Decimal(28, 8)
  updatedAt DateTime @updatedAt
}
